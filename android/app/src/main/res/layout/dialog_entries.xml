<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <Switch
        android:id="@+id/watch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/watch_label"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <Button
        android:id="@+id/add_tile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/add_tile" />

    <TextView
        style="@style/Section"
        android:text="@string/section_originals" />

    <Switch
        android:id="@+id/trash_after_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trash_after_share"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <Switch
        android:id="@+id/trash_after_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/trash_after_save"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <Button
        android:id="@+id/manage_media"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/entries_help"
        android:textColor="@color/muted"
        android:textSize="13sp" />
</LinearLayout>
